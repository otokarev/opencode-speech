{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@opencode/plugin": ["./types/opencode-plugin.d.ts"],
      "@opencode/plugin/tui": ["./types/opencode-plugin-tui.d.ts"]
    }
  },
  "include": ["plugin/**/*.ts", "types/**/*.d.ts"]
}
